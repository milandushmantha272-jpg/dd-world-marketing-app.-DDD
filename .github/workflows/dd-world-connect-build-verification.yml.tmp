name: DD WORLD CONNECT Final Android Build Verification

on:
  push:
    branches:
      - main
      - feature/dd-world-connect-foundation
      - feature/commission-center
      - feature/dialog-reports-ezcash
      - feature/communication-collaboration
  pull_request:
    branches:
      - main
      - feature/dd-world-connect-foundation
      - feature/commission-center
      - feature/dialog-reports-ezcash
  workflow_dispatch:

permissions:
  contents: read

jobs:
  verify-flutter:
    name: Flutter analysis, tests, debug and release APK
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: dd_world_connect
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Restore missing Flutter Android platform
        shell: bash
        run: |
          set -euo pipefail
          if [[ ! -f android/app/build.gradle && ! -f android/app/build.gradle.kts ]]; then
            echo "Flutter Android platform is missing in dd_world_connect; generating Android scaffold without touching lib/ or pubspec.yaml."
            flutter create --platforms=android --org com.ddworld.marketing --project-name dd_world_connect .
          fi
          test -d android
          test -d android/app
          test -d android/app/src/main
          test -f android/app/src/main/AndroidManifest.xml
          test -f android/settings.gradle || test -f android/settings.gradle.kts
          test -f android/gradle.properties
          test -f android/app/build.gradle || test -f android/app/build.gradle.kts
          if [[ -f android/app/build.gradle.kts ]]; then
            sed -i -E "s/compileSdk = flutter\\.compileSdkVersion/compileSdk = 36/" android/app/build.gradle.kts
          else
            sed -i -E "s/compileSdkVersion flutter\\.compileSdkVersion/compileSdkVersion 36/; s/compileSdk flutter\\.compileSdkVersion/compileSdk 36/" android/app/build.gradle
          fi
          echo "Android compileSdk pinned to API 36 for current Flutter plugins."
          echo "Verified Flutter Android platform files:"
          find android -maxdepth 4 -type f | sort | head -100

      - name: flutter pub get
        run: flutter pub get

      - name: flutter analyze
        run: flutter analyze

      - name: flutter test
        run: flutter test

      - name: flutter build apk --debug
        shell: bash
        run: |
          start=$(date +%s)
          flutter build apk --debug
          end=$(date +%s)
          echo "DEBUG_BUILD_SECONDS=$((end-start))" >> "$GITHUB_ENV"
          test -s build/app/outputs/flutter-apk/app-debug.apk
          ls -lh build/app/outputs/flutter-apk/app-debug.apk

      - name: flutter build apk --release
        shell: bash
        run: |
          start=$(date +%s)
          flutter build apk --release
          end=$(date +%s)
          echo "RELEASE_BUILD_SECONDS=$((end-start))" >> "$GITHUB_ENV"
          test -s build/app/outputs/flutter-apk/app-release.apk
          ls -lh build/app/outputs/flutter-apk/app-release.apk

      - name: Summarize APK artifacts
        if: always()
        shell: bash
        run: |
          {
            echo "## DD WORLD CONNECT Android build results"
            echo
            for apk in build/app/outputs/flutter-apk/app-debug.apk build/app/outputs/flutter-apk/app-release.apk; do
              if [ -s "$apk" ]; then
                size=$(du -h "$apk" | cut -f1)
                bytes=$(stat -c%s "$apk")
                echo "- **$(basename "$apk")**: PASS — $size ($bytes bytes)"
              else
                echo "- **$(basename "$apk")**: FAIL — artifact missing"
              fi
            done
            echo
            echo "- Debug build duration: ${DEBUG_BUILD_SECONDS:-not completed} seconds"
            echo "- Release build duration: ${RELEASE_BUILD_SECONDS:-not completed} seconds"
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Upload debug APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: dd-world-connect-debug-apk
          path: dd_world_connect/build/app/outputs/flutter-apk/app-debug.apk
          if-no-files-found: error
          retention-days: 7

      - name: Upload release APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: dd-world-connect-release-apk
          path: dd_world_connect/build/app/outputs/flutter-apk/app-release.apk
          if-no-files-found: error
          retention-days: 7
